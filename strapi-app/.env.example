HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# --- Nur in Produktion gesetzt -------------------------------------------

# Postgres (Neon). Ohne DATABASE_CLIENT bleibt es lokal bei SQLite.
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true
# DATABASE_POOL_MIN=0
# DATABASE_POOL_MAX=5

# Oeffentliche Adressen — noetig hinter dem Reverse Proxy
# PUBLIC_URL=https://cms.tim-peters.work
# FRONTEND_URL=https://research.tim-peters.work
# IS_PROXIED=true

# Medien-Bucket (Cloudflare R2). Solange R2_BUCKET leer ist, speichert
# Strapi Uploads lokal unter public/uploads.
# R2_PUBLIC_URL=https://media.tim-peters.work
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=research-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
