---
import type { Article } from '../lib/strapi';
import { formatDate, mediaUrlFormat, estimateReadingTime } from '../lib/strapi';

interface Props {
  article: Article;
  /** groessere Darstellung fuer die Startseite */
  featured?: boolean;
}

const { article, featured = false } = Astro.props;

const cover = mediaUrlFormat(article.coverImage, featured ? 'medium' : 'small');
const minutes = article.readingTime ?? estimateReadingTime(article.content);
---
<article class:list={['card', featured && 'card--featured']}>
  {
    cover && (
      <div class="card__media">
        <img
          src={cover}
          alt={article.coverImage?.alternativeText ?? ''}
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <div class="card__body">
    <div class="card__meta">
      {
        article.category && (
          <a class="card__category" href={`/category/${article.category.slug}`}>
            {article.category.name}
          </a>
        )
      }
      <time datetime={article.publishedDate}>{formatDate(article.publishedDate)}</time>
      <span>{minutes} Min. Lesezeit</span>
    </div>

    <h2 class="card__title">
      <a class="card__link" href={`/articles/${article.slug}`}>{article.title}</a>
    </h2>

    <p class="card__abstract">{article.abstract}</p>

    {
      article.originalPaperType && (
        <p class="card__source">
          Basiert auf einer <strong>{article.originalPaperType}</strong>
        </p>
      )
    }
  </div>
</article>
