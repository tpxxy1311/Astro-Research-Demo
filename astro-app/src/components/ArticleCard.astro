---
// Ein Eintrag der Artikelliste — in beiden Ansichten dasselbe Markup.
//
// Welche Ansicht gilt, entscheidet die Modifier-Klasse am .entries-Container
// (--list oder --grid), nicht ein Prop hier. Die Komponente liefert deshalb
// immer alles; Bild, Nummer und Pfeil blendet das CSS je Ansicht aus. So bleibt
// ein spaeterer Umschalter ein Klassentausch auf einem Element, statt beide
// Baeume zu rendern oder clientseitig neu zu bauen.
import type { Article } from '../lib/strapi';
import { formatDate, mediaUrlFormat, estimateReadingTime } from '../lib/strapi';

interface Props {
  article: Article;
  /** laufende Nummer, zweistellig ausgegeben — nur die Zeilenansicht zeigt sie */
  index?: number;
}

const { article, index } = Astro.props;

// 'medium' statt 'small': in der Grid-Ansicht ist eine Karte auf grossen
// Schirmen rund 380 px breit, was auf Retina-Geraeten 760 px verlangt.
const cover = mediaUrlFormat(article.coverImage, 'medium');
const minutes = article.readingTime ?? estimateReadingTime(article.content);
const indexLabel = index === undefined ? null : String(index).padStart(2, '0');
---
<article class="entry">
  {cover && (
    <div class="entry__media">
      <img
        src={cover}
        alt={article.coverImage?.alternativeText ?? ''}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  {/* Kopfzeile: Nummer und Meta teilen sich eine Zeile. Sie brauchen dafuer
      diesen gemeinsamen Elternknoten — als Geschwister in der Flex-Spalte des
      Eintrags stuenden sie zwangslaeufig untereinander. */}
  <div class="entry__head">
    {indexLabel && <span class="entry__index">{indexLabel}</span>}

    <div class="entry__meta">
      {article.category && (
        <a class="category-link" href={`/category/${article.category.slug}`}>
          {article.category.name}
        </a>
      )}
      <time datetime={article.publishedDate}>{formatDate(article.publishedDate)}</time>
      <span>{minutes} Min.</span>
      {article.originalPaperType && <span>{article.originalPaperType}</span>}
    </div>
  </div>
  <div class="entry__main">
    <h2 class="entry__title">
      <a class="entry__link" href={`/articles/${article.slug}`}>
        {article.title}
      </a>
    </h2>
    <p class="entry__abstract">{article.abstract}</p>
  </div>

</article>
