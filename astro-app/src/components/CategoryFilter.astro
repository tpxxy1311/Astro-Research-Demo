---
import type { Category } from '../lib/strapi';

interface Props {
  categories: Category[];
  /** null = "All" ist aktiv */
  active?: string | null;
}

const { categories, active = null } = Astro.props;

const items = [
  { slug: null, name: 'All' },
  ...categories.map((category) => ({ slug: category.slug, name: category.name })),
];
---
<nav class="category-filter" aria-label="Filter by category">
  <ul class="category-filter__list">
    {
      items.map((item) => (
        <li>
          <a
            class="category-filter__link"
            href={item.slug ? `/category/${item.slug}` : '/articles'}
            aria-current={item.slug === active ? 'page' : undefined}
          >
            {item.name}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
