---
import type { Category } from '../lib/strapi';

interface Props {
  categories: Category[];
  /** null = "Alle" ist aktiv */
  active?: string | null;
}

const { categories, active = null } = Astro.props;

const items = [{ slug: null, name: 'Alle' }, ...categories.map((c) => ({ slug: c.slug, name: c.name }))];
---
<nav aria-label="Nach Kategorie filtern" class="border-b border-slate-200 dark:border-slate-800">
  <ul class="-mb-px flex flex-wrap gap-1">
    {
      items.map((item) => (
        <li>
          <a
            href={item.slug ? `/category/${item.slug}` : '/articles'}
            aria-current={item.slug === active ? 'page' : undefined}
            class:list={[
              'inline-block border-b-2 px-4 py-3 text-sm transition-colors',
              item.slug === active
                ? 'border-slate-900 font-medium text-slate-900 dark:border-slate-100 dark:text-slate-100'
                : 'border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-900 dark:text-slate-400 dark:hover:border-slate-600 dark:hover:text-slate-100',
            ]}
          >
            {item.name}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
