---
import type { Tag } from '../lib/strapi';

interface Props {
  tags: Tag[];
  /** aktiver Tag-Slug, wird hervorgehoben */
  active?: string | null;
  size?: 'sm' | 'md';
}

const { tags, active = null, size = 'sm' } = Astro.props;
---
{
  tags.length > 0 && (
    <ul class:list={['tag-list', `tag-list--${size}`]}>
      {tags.map((tag) => (
        <li>
          <a
            class:list={['tag-list__tag', tag.slug === active && 'tag-list__tag--active']}
            href={`/tag/${tag.slug}`}
          >
            #{tag.name}
          </a>
        </li>
      ))}
    </ul>
  )
}
