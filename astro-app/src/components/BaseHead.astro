---
import { Font } from 'astro:assets';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  /** Absolute oder relative URL des Vorschaubilds. */
  image?: string | null;
  type?: 'website' | 'article';
  publishedDate?: string | null;
}

const { title, description, image, type = 'website', publishedDate } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImage = image ? new URL(image, Astro.site ?? Astro.url).href : null;
const fullTitle = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

<!-- Gibt die @font-face-Regeln aus; preload, weil DM Sans die Grundschrift ist. -->
<Font cssVariable="--font-dm-sans" preload />
<link rel="canonical" href={canonical.href} />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site ?? Astro.url).href} />

<title>{fullTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:site_name" content={SITE_TITLE} />
{socialImage && <meta property="og:image" content={socialImage} />}
{publishedDate && <meta property="article:published_time" content={publishedDate} />}

<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{socialImage && <meta name="twitter:image" content={socialImage} />}
