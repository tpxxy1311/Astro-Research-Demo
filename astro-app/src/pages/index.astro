---
import HomeLayout from '../layouts/HomeLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import StretchType from '../components/StretchType.astro';
import { Icon } from 'astro-icon/components';
import EmptyState from '../components/EmptyState.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getArticles, getAuthor } from '../lib/strapi';

const [articles, author] = await Promise.all([getArticles(), getAuthor()]);

// Drei, und keine Hervorhebung davor: die Startseite steht auf einer
// Bildschirmhoehe (siehe .home-shell in pages/_home.scss), mehr passt nicht
// darauf. Featured-Artikel sind deshalb nicht mehr ausgenommen — sie stehen
// hier als gewoehnliche Eintraege, wenn sie zu den neuesten gehoeren.
const latest = articles.slice(0, 3);
---
<HomeLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="container hero">
    <h1 class="hero__wordmark">
      {/* Beide Werte gelten fuer DM Sans wght 700, siehe _stretch-type.scss:
          balance 0.508 = natuerlicher Breitenanteil von TIMPETERS
          (Vorschubbreiten 5.367em zu 5.191em), cap 66 = Versalhoehe, bei der
          die Buchstaben unverzerrt stehen. Wird das Gewicht geaendert,
          gehoeren beide Zahlen nachgezogen. */}
      <StretchType left="TIMPETERS" right="RESEARCH" balance={0.508} cap={66} />
    </h1>
    <p class="lead hero__text">
      I'm a creative developer based near Offenburg, Germany, with a
      passion for crafting web experiences that balance aesthetics,
      performance, and thoughtful interactions. 
      This site collects the papers and academic work I've written 
      throughout my studies, 
      reworked and presented in a way that balances scholarly depth with 
      genuine readability. 
    </p>
  </section>

  <section class="container section">
    <div class="section__header">
      <!-- <h2 class="eyebrow">Latest Publications</h2> -->
      {articles.length > 0 && (
        <a class="button button--pill" href="/articles">
          {/* Scharfe Ecke — Lucides corner-down-right rundet sie mit einem
              Bogen ab, deshalb liegt dieses eine Icon lokal in src/icons/. */}
          <Icon class="button__arrow" name="lucide:corner-down-right" />
          All Articles
        </a>
      )}
    </div>

    {
      latest.length > 0 ? (
        /* Beide Modifier: --grid traegt Rahmen, Schatten und Fusszeile der
           Karte, --compact nimmt das Titelbild weg und laesst die Reihe die
           restliche Bildschirmhoehe fuellen. */
        <div class="entries entries--grid entries--compact">
          {latest.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      ) : (
        <EmptyState
          title="No articles published yet."
          hint="Create an entry under Content Manager → Article in the Strapi admin and publish it."
        />
      )
    }
  </section>
</HomeLayout>
