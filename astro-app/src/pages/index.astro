---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getArticles, getAuthor } from '../lib/strapi';

const [articles, author] = await Promise.all([getArticles(), getAuthor()]);

const featured = articles.filter((article) => article.featured).slice(0, 2);
// Auf der Startseite nichts doppelt zeigen.
const featuredIds = new Set(featured.map((article) => article.id));
const latest = articles.filter((article) => !featuredIds.has(article.id)).slice(0, 6);
---
<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="container hero">
    <h1 class="hero__title">Wissenschaftliche Arbeiten, ohne den Ballast.</h1>
    <p class="hero__text">
      {SITE_DESCRIPTION}
      {author && <> Geschrieben von {author.name}.</>}
    </p>
    <div class="hero__actions">
      <a class="button button--primary" href="/articles">Alle Artikel</a>
      <a class="button button--secondary" href="/about">Ueber mich</a>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="container section">
        <h2 class="eyebrow section__heading">Hervorgehoben</h2>
        <div class="card-grid">
          {featured.map((article) => (
            <ArticleCard article={article} featured />
          ))}
        </div>
      </section>
    )
  }

  <section class="container section">
    <div class="section__header">
      <h2 class="eyebrow">Neueste Artikel</h2>
      {articles.length > 0 && <a class="section__more" href="/articles">Alle ansehen &rarr;</a>}
    </div>

    {
      latest.length > 0 ? (
        <div class="card-grid card-grid--two">
          {latest.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      ) : (
        featured.length === 0 && (
          <EmptyState
            title="Noch keine Artikel veroeffentlicht."
            hint="Lege im Strapi-Admin unter Content Manager → Article einen Eintrag an und veroeffentliche ihn."
          />
        )
      )
    }
  </section>
</BaseLayout>
