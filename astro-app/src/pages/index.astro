---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getArticles, getAuthor } from '../lib/strapi';

const [articles, author] = await Promise.all([getArticles(), getAuthor()]);

const featured = articles.filter((article) => article.featured).slice(0, 2);
// Auf der Startseite nichts doppelt zeigen.
const featuredIds = new Set(featured.map((article) => article.id));
const latest = articles.filter((article) => !featuredIds.has(article.id)).slice(0, 6);
---
<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="mx-auto max-w-5xl px-5 py-16 sm:py-24">
    <h1 class="max-w-3xl text-4xl font-bold leading-tight tracking-tight text-slate-900 sm:text-5xl dark:text-slate-100">
      Wissenschaftliche Arbeiten, ohne den Ballast.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
      {SITE_DESCRIPTION}
      {author && <> Geschrieben von {author.name}.</>}
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/articles"
        class="rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-300"
      >
        Alle Artikel
      </a>
      <a
        href="/about"
        class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 transition-colors hover:border-slate-400 hover:text-slate-900 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-500 dark:hover:text-slate-100"
      >
        Ueber mich
      </a>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="mx-auto max-w-5xl px-5 pb-16">
        <h2 class="mb-6 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Hervorgehoben
        </h2>
        <div class="grid gap-6">
          {featured.map((article) => (
            <ArticleCard article={article} featured />
          ))}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-5xl px-5 pb-16">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        Neueste Artikel
      </h2>
      {
        articles.length > 0 && (
          <a
            href="/articles"
            class="text-sm text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100"
          >
            Alle ansehen &rarr;
          </a>
        )
      }
    </div>

    {
      latest.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2">
          {latest.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      ) : (
        featured.length === 0 && (
          <EmptyState
            title="Noch keine Artikel veroeffentlicht."
            hint="Lege im Strapi-Admin unter Content Manager → Article einen Eintrag an und veroeffentliche ihn."
          />
        )
      )
    }
  </section>
</BaseLayout>
