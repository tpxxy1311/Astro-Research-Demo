---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import TagList from '../../components/TagList.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getArticles, getCategories, getTags } from '../../lib/strapi';

const [articles, categories, tags] = await Promise.all([
  getArticles(),
  getCategories(),
  getTags(),
]);
---
<BaseLayout
  title="Artikel"
  description="Alle aufbereiteten Arbeiten im Ueberblick — filterbar nach Kategorie und Schlagwort."
>
  <div class="container page">
    <header class="page__head">
      <h1 class="title">All Publications</h1>
      <p class="lead hero__text__left">
      I'm a creative developer based near Offenburg, Germany, with a
      passion for crafting web experiences that balance aesthetics,
      performance, and thoughtful interactions. 
      This site collects the papers and academic work I've written 
      throughout my studies, 
      reworked and presented in a way that balances scholarly depth with 
      genuine readability. 
    </p>
      <!-- <p class="page__count">
        {articles.length} {articles.length === 1 ? 'Beitrag' : 'Beitraege'}
      </p> -->
    </header>

    <div class="page__toolbar">
      {categories.length > 0 && <CategoryFilter categories={categories} active={null} />}

      {
        articles.length > 0 && (
          <div class="button-group-left" role="group" aria-label="Ansicht" data-view-switch>
            <button class="button button--switch" type="button" data-view="grid" aria-pressed="true">
              Grid
            </button>
            <button class="button button--switch" type="button" data-view="list" aria-pressed="false">
              List
            </button>
          </div>
        )
      }
    </div>

    {
      articles.length > 0 ? (
        <div class="entries entries--grid" data-view-target>
          {articles.map((article, i) => (
            <ArticleCard article={article} index={i + 1} />
          ))}
        </div>
      ) : (
        <EmptyState
          title="Noch keine Artikel veroeffentlicht."
          hint="Lege im Strapi-Admin unter Content Manager → Article einen Eintrag an und veroeffentliche ihn."
        />
      )
    }

    {
      tags.length > 0 && (
        <section class="page__tags">
          <h2 class="eyebrow">Nach Schlagwort</h2>
          <TagList tags={tags} size="md" />
        </section>
      )
    }
  </div>

  <script is:inline>
    // Bewusst is:inline und direkt hinter der Liste: ein gebuendeltes Modul
    // liefe erst nach dem Parsen, die gespeicherte Ansicht wuerde dann sichtbar
    // umklappen. So steht sie schon vor dem ersten Paint.
    (() => {
      const group = document.querySelector('[data-view-switch]');
      const list = document.querySelector('[data-view-target]');
      if (!group || !list) return;

      const KEY = 'articles-view';

      const apply = (view) => {
        list.classList.toggle('entries--grid', view === 'grid');
        list.classList.toggle('entries--list', view === 'list');
        for (const option of group.querySelectorAll('[data-view]')) {
          // Der gedrueckte Zustand liegt nur hier — das CSS liest ihn mit.
          option.setAttribute('aria-pressed', String(option.dataset.view === view));
        }
      };

      // In abgeschotteten Browser-Modi wirft der Zugriff auf localStorage. Das
      // darf den Umschalter nicht mitnehmen, er soll dann nur nichts merken.
      let store = null;
      try {
        store = window.localStorage;
      } catch {}

      const stored = store?.getItem(KEY);
      if (stored === 'grid' || stored === 'list') apply(stored);

      group.addEventListener('click', (event) => {
        const option = event.target.closest('[data-view]');
        if (!option) return;
        apply(option.dataset.view);
        try {
          store?.setItem(KEY, option.dataset.view);
        } catch {}
      });
    })();
  </script>
</BaseLayout>
