---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import TagList from '../../components/TagList.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getArticles, getCategories, getTags } from '../../lib/strapi';

const [articles, categories, tags] = await Promise.all([
  getArticles(),
  getCategories(),
  getTags(),
]);
---
<BaseLayout
  title="Artikel"
  description="Alle aufbereiteten Arbeiten im Ueberblick — filterbar nach Kategorie und Schlagwort."
>
  <div class="container page">
    <h1 class="page__title">Artikel</h1>
    <p class="page__lead">
      {articles.length}
      {articles.length === 1 ? 'Artikel' : 'Artikel'} insgesamt.
    </p>

    {
      categories.length > 0 && (
        <div class="page__filter">
          <CategoryFilter categories={categories} active={null} />
        </div>
      )
    }

    <div class="page__content">
      {
        articles.length > 0 ? (
          <div class="card-grid card-grid--two">
            {articles.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        ) : (
          <EmptyState
            title="Noch keine Artikel veroeffentlicht."
            hint="Lege im Strapi-Admin unter Content Manager → Article einen Eintrag an und veroeffentliche ihn."
          />
        )
      }
    </div>

    {
      tags.length > 0 && (
        <section class="page__tags">
          <h2 class="eyebrow page__tags-heading">Nach Schlagwort</h2>
          <TagList tags={tags} size="md" />
        </section>
      )
    }
  </div>
</BaseLayout>
