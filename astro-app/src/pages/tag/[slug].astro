---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import TagList from '../../components/TagList.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getTags, getArticlesByTag } from '../../lib/strapi';
import type { Article, Tag } from '../../lib/strapi';

export async function getStaticPaths() {
  const tags = await getTags();

  return Promise.all(
    tags.map(async (tag) => ({
      params: { slug: tag.slug },
      props: {
        tag,
        tags,
        articles: await getArticlesByTag(tag.slug),
      },
    }))
  );
}

interface Props {
  tag: Tag;
  tags: Tag[];
  articles: Article[];
}

const { tag, tags, articles } = Astro.props;
---
<BaseLayout title={`#${tag.name}`} description={`All articles tagged ${tag.name}.`}>
  <div class="container page">
    <header class="page__head">
      <p class="eyebrow">Tag</p>
      <h1 class="title">{tag.name}</h1>
    </header>

    <div class="page__filter">
      <TagList tags={tags} active={tag.slug} size="md" />
    </div>

    {
      articles.length > 0 ? (
        <div class="entries entries--list">
          {articles.map((article, i) => (
            <ArticleCard article={article} index={i + 1} />
          ))}
        </div>
      ) : (
        <EmptyState title={`No articles tagged "${tag.name}" yet.`} />
      )
    }
  </div>
</BaseLayout>
