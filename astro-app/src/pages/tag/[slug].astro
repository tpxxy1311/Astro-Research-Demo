---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import TagList from '../../components/TagList.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getTags, getArticlesByTag } from '../../lib/strapi';
import type { Article, Tag } from '../../lib/strapi';

export async function getStaticPaths() {
  const tags = await getTags();

  return Promise.all(
    tags.map(async (tag) => ({
      params: { slug: tag.slug },
      props: {
        tag,
        tags,
        articles: await getArticlesByTag(tag.slug),
      },
    }))
  );
}

interface Props {
  tag: Tag;
  tags: Tag[];
  articles: Article[];
}

const { tag, tags, articles } = Astro.props;
---
<BaseLayout title={`#${tag.name}`} description={`Alle Artikel zum Schlagwort ${tag.name}.`}>
  <div class="mx-auto max-w-5xl px-5 py-12 sm:py-16">
    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
      Schlagwort
    </p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
      #{tag.name}
    </h1>

    <div class="mt-8">
      <TagList tags={tags} active={tag.slug} size="md" />
    </div>

    {
      articles.length > 0 ? (
        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          {articles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      ) : (
        <div class="mt-10">
          <EmptyState title={`Zu "#${tag.name}" ist noch kein Artikel veroeffentlicht.`} />
        </div>
      )
    }
  </div>
</BaseLayout>
