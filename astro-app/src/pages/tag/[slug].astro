---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import TagList from '../../components/TagList.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getTags, getArticlesByTag } from '../../lib/strapi';
import type { Article, Tag } from '../../lib/strapi';

export async function getStaticPaths() {
  const tags = await getTags();

  return Promise.all(
    tags.map(async (tag) => ({
      params: { slug: tag.slug },
      props: {
        tag,
        tags,
        articles: await getArticlesByTag(tag.slug),
      },
    }))
  );
}

interface Props {
  tag: Tag;
  tags: Tag[];
  articles: Article[];
}

const { tag, tags, articles } = Astro.props;
---
<BaseLayout title={`#${tag.name}`} description={`Alle Artikel zum Schlagwort ${tag.name}.`}>
  <div class="container page">
    <p class="eyebrow">Schlagwort</p>
    <h1 class="page__title">#{tag.name}</h1>

    <div class="page__filter">
      <TagList tags={tags} active={tag.slug} size="md" />
    </div>

    <div class="page__content">
      {
        articles.length > 0 ? (
          <div class="card-grid card-grid--two">
            {articles.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        ) : (
          <EmptyState title={`Zu "#${tag.name}" ist noch kein Artikel veroeffentlicht.`} />
        )
      }
    </div>
  </div>
</BaseLayout>
