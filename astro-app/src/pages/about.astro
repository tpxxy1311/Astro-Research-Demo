---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlocksRenderer from '../components/BlocksRenderer.astro';
import EmptyState from '../components/EmptyState.astro';
import { getAuthor, mediaUrlFormat } from '../lib/strapi';

const author = await getAuthor();
const avatar = mediaUrlFormat(author?.avatar, 'small');
---
<BaseLayout
  title="About"
  description={author ? `About ${author.name} and this site.` : 'About this site.'}
  image={avatar}
>
  <div class="container container--prose page">
    {
      author ? (
        <>
          <header class="page__head">
            <p class="eyebrow">About</p>
            <div class="profile">
              {avatar && (
                <img
                  class="profile__avatar"
                  src={avatar}
                  alt={author.avatar?.alternativeText ?? author.name}
                />
              )}
              <div>
                <h1 class="title">{author.name}</h1>
                {author.socialLinks?.length > 0 && (
                  <ul class="profile__links">
                    {author.socialLinks.map((link) => (
                      <li>
                        <a href={link.url} target="_blank" rel="noopener noreferrer me">
                          {link.platform}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </header>

          <div class="page__body">
            <BlocksRenderer content={author.bio} />
          </div>
        </>
      ) : (
        <>
          <header class="page__head">
            <p class="eyebrow">About</p>
            <h1 class="title">Author Profile</h1>
          </header>
          <EmptyState
            title="No author profile has been set up yet."
            hint="Fill it in under Content Manager → Author in the Strapi admin and publish it."
          />
        </>
      )
    }
  </div>
</BaseLayout>
