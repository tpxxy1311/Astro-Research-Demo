---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlocksRenderer from '../components/BlocksRenderer.astro';
import EmptyState from '../components/EmptyState.astro';
import { getAuthor, mediaUrlFormat } from '../lib/strapi';

const author = await getAuthor();
const avatar = mediaUrlFormat(author?.avatar, 'small');
---
<BaseLayout
  title="Ueber mich"
  description={author ? `Ueber ${author.name} und diesen Blog.` : 'Ueber diesen Blog.'}
  image={avatar}
>
  <div class="container container--prose page">
    {
      author ? (
        <>
          <div class="profile">
            {avatar && (
              <img
                class="profile__avatar"
                src={avatar}
                alt={author.avatar?.alternativeText ?? author.name}
              />
            )}
            <div>
              <h1 class="profile__name">{author.name}</h1>
              {author.socialLinks?.length > 0 && (
                <ul class="profile__links">
                  {author.socialLinks.map((link) => (
                    <li>
                      <a href={link.url} target="_blank" rel="noopener noreferrer me">
                        {link.platform}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>

          <div class="page__body">
            <BlocksRenderer content={author.bio} />
          </div>
        </>
      ) : (
        <>
          <h1 class="page__title">Ueber mich</h1>
          <div class="page__body">
            <EmptyState
              title="Es ist noch kein Autorenprofil hinterlegt."
              hint="Im Strapi-Admin unter Content Manager → Author ausfuellen und veroeffentlichen."
            />
          </div>
        </>
      )
    }
  </div>
</BaseLayout>
