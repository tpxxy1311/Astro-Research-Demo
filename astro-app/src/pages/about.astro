---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlocksRenderer from '../components/BlocksRenderer.astro';
import EmptyState from '../components/EmptyState.astro';
import { getAuthor, mediaUrlFormat } from '../lib/strapi';

const author = await getAuthor();
const avatar = mediaUrlFormat(author?.avatar, 'small');
---
<BaseLayout
  title="Ueber mich"
  description={author ? `Ueber ${author.name} und diesen Blog.` : 'Ueber diesen Blog.'}
  image={avatar}
>
  <div class="mx-auto max-w-3xl px-5 py-12 sm:py-16">
    {
      author ? (
        <>
          <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
            {avatar && (
              <img
                src={avatar}
                alt={author.avatar?.alternativeText ?? author.name}
                class="h-24 w-24 shrink-0 rounded-full object-cover"
              />
            )}
            <div>
              <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
                {author.name}
              </h1>
              {author.socialLinks?.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-4 text-sm">
                  {author.socialLinks.map((link) => (
                    <li>
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer me"
                        class="text-slate-600 underline decoration-slate-300 underline-offset-4 transition-colors hover:text-slate-900 dark:text-slate-400 dark:decoration-slate-600 dark:hover:text-slate-100"
                      >
                        {link.platform}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>

          <div class="mt-10 text-lg text-slate-800 dark:text-slate-200">
            <BlocksRenderer content={author.bio} />
          </div>
        </>
      ) : (
        <>
          <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
            Ueber mich
          </h1>
          <div class="mt-8">
            <EmptyState
              title="Es ist noch kein Autorenprofil hinterlegt."
              hint="Im Strapi-Admin unter Content Manager → Author ausfuellen und veroeffentlichen."
            />
          </div>
        </>
      )
    }
  </div>
</BaseLayout>
