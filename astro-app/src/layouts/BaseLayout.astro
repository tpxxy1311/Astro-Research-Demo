---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_LANG } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: string | null;
  type?: 'website' | 'article';
  publishedDate?: string | null;
}

const { title, description, image, type, publishedDate } = Astro.props;
---
<!doctype html>
<html lang={SITE_LANG} class="scroll-pt-24">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
      publishedDate={publishedDate}
    />
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-200">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
