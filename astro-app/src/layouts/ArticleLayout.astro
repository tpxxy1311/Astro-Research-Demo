---
import BaseLayout from './BaseLayout.astro';
import BlocksRenderer from '../components/BlocksRenderer.astro';
import TagList from '../components/TagList.astro';
import { Icon } from 'astro-icon/components';
import type { Article } from '../lib/strapi';
import { formatDate, mediaUrl, mediaUrlFormat, estimateReadingTime } from '../lib/strapi';

interface Props {
  article: Article;
}

const { article } = Astro.props;

const cover = mediaUrlFormat(article.coverImage, 'large');
const paperFile = mediaUrl(article.originalPaperFile);
const minutes = article.readingTime ?? estimateReadingTime(article.content);

// Strapi gibt die Dateigroesse in KB an.
const fileSizeLabel = article.originalPaperFile
  ? `${Math.max(1, Math.round(article.originalPaperFile.size))} KB`
  : null;

const hasPaperInfo = Boolean(article.originalPaperTitle || article.originalPaperType || paperFile);
---
<BaseLayout
  title={article.title}
  description={article.abstract}
  image={cover}
  type="article"
  publishedDate={article.publishedDate}
>
  <article class="container container--prose article">
    <header>
      <div class="article__meta">
        {
          article.category && (
            <a class="article__category" href={`/category/${article.category.slug}`}>
              {article.category.name}
            </a>
          )
        }
        <time datetime={article.publishedDate}>{formatDate(article.publishedDate)}</time>
        <span>{minutes} Min. Lesezeit</span>
      </div>

      <h1 class="article__title">{article.title}</h1>
      <p class="article__abstract">{article.abstract}</p>
    </header>

    {
      cover && (
        <img
          class="article__cover"
          src={cover}
          alt={article.coverImage?.alternativeText ?? ''}
          width={article.coverImage?.width ?? undefined}
          height={article.coverImage?.height ?? undefined}
        />
      )
    }

    <!-- {
      hasPaperInfo && (
        <aside class="paper">
          {/* <h2 class="paper__label">Zugrundeliegende Arbeit</h2>
          {article.originalPaperTitle && (
            <p class="paper__title">{article.originalPaperTitle}</p>
          )}
          {article.originalPaperType && <p class="paper__type">{article.originalPaperType}</p>} */}
          {paperFile && (
            <a class="button button--primary paper__download" href={paperFile} download>
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M10 2a1 1 0 0 1 1 1v7.586l2.293-2.293a1 1 0 1 1 1.414 1.414l-4 4a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L9 10.586V3a1 1 0 0 1 1-1Z" />
                <path d="M3 14a1 1 0 0 1 1 1v1h12v-1a1 1 0 1 1 2 0v1a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-1a1 1 0 0 1 1-1Z" />
              </svg>
              Originalarbeit als PDF
              {fileSizeLabel && <span class="paper__size">({fileSizeLabel})</span>}
            </a>
          )}
        </aside>
      )
    } -->

    <div class="article__body">
      <BlocksRenderer content={article.content} />
    </div>

    <!-- {
      article.tags?.length > 0 && (
        <footer class="article__footer">
          <h2 class="eyebrow">Schlagworte</h2>
          <TagList tags={article.tags} size="md" />
        </footer>
      )
    } -->

    <a class="button button--pill" href="/articles">
          {/* --back kehrt die Hover-Bewegung um: der Pfeil zeigt nach links,
              also muss er beim Hover auch nach links ruecken. */}
          <Icon class="button__arrow button__arrow--back" name="lucide:corner-down-left" />
          All Articles
        </a>
  </article>
</BaseLayout>
